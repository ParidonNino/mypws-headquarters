# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and is never baked into the Docker image — docker-compose
# reads it at container start via env_file.

# --- Notion data access ---------------------------------------------------
# Internal integration token. Every signed-in user's reads and writes go
# through this one credential, so the whole team sees the same roadmap.
NOTION_TOKEN=secret_replace_with_your_notion_token
NOTION_ROADMAP_DATA_SOURCE_ID=replace-with-roadmap-data-source-id
NOTION_WORKBLOCKS_DATA_SOURCE_ID=replace-with-workblocks-data-source-id

# --- Aanmelden via Notion (OAuth) ----------------------------------------
# From your Notion *public* integration (Settings -> Connections -> your
# integration -> OAuth). Required: without these the app refuses all requests.
NOTION_OAUTH_CLIENT_ID=replace-with-oauth-client-id
NOTION_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Signing key for the session cookie. Generate a fresh random value:
#   node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing session.
SESSION_SECRET=replace-with-a-long-random-string

# At least ONE of the two below is mandatory — the app refuses to start without
# one. Notion OAuth authenticates any Notion account in any workspace, so with
# neither set a successful login would prove only "is a Notion user".
#
# Your workspace id is only knowable after a first login: the server logs it on
# success while this is still empty. Start with ALLOWED_EMAILS, then fill this
# in and optionally clear the allowlist to admit the whole workspace.
NOTION_WORKSPACE_ID=

# Comma-separated. Works on its own, or as a narrower filter on top of the
# workspace check above.
ALLOWED_EMAILS=you@powerselect.app

# The origin the app is reached on. Used to build the OAuth redirect_uri, so it
# must exactly match a redirect URI registered on the Notion connection. Use
# localhost, not 127.0.0.1 — Notion rejects IP addresses as callbacks, and
# cookies are per-host so the two are not interchangeable.
APP_ORIGIN=http://localhost:3000

# Escape hatch for working on the UI before the Notion integration exists.
# Set to exactly "true" to skip all authentication. Never enable this on
# anything reachable from outside your own machine.
AUTH_DISABLED=

# Set to exactly "true" only when running behind the optional nginx proxy
# (docker compose --profile proxy up), which terminates TLS. It makes the app
# honour X-Forwarded-Proto / X-Forwarded-Host. Leave empty otherwise: without a
# real proxy in front, a client could send those headers itself.
TRUST_PROXY=
