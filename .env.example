# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and is never baked into the Docker image — docker-compose
# reads it at container start via env_file.
NOTION_TOKEN=secret_replace_with_your_notion_token
NOTION_ROADMAP_DATA_SOURCE_ID=replace-with-roadmap-data-source-id
NOTION_WORKBLOCKS_DATA_SOURCE_ID=replace-with-workblocks-data-source-id
